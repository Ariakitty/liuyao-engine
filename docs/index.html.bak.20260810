<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>六爻占卜 · 纳甲装卦引擎</title>
<style>
:root{--cream:#fff8f0;--paper:#fffdf9;--ink:#594e55;--muted:#8b7b80;--pink:#d99a9e;--pink-deep:#b8737b;--mint:#9fc9b7;--blue:#91afc4;--line:#f0e2dd;--gold:#c9a86a;--gold-deep:#8a6f3d}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;min-height:100dvh;background:radial-gradient(circle at 10% 8%,#f8dfe0 0 7%,transparent 22%),radial-gradient(circle at 92% 20%,#dcecf0 0 6%,transparent 20%),linear-gradient(155deg,#fff8f0,#fffdf8 55%,#f3fbf5);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
main{max-width:640px;margin:0 auto;padding:34px 18px 60px}
h1{font-size:26px;margin:8px 0 6px;text-align:center;letter-spacing:.06em}
.sub{text-align:center;color:var(--muted);font-size:13px;margin:0 0 24px;line-height:1.8}
.card{background:rgba(255,253,249,.9);border:1px solid rgba(218,179,176,.45);border-radius:24px;padding:20px;box-shadow:0 16px 44px rgba(121,91,91,.12);backdrop-filter:blur(10px)}
label{font-size:13px;color:var(--muted);display:block;margin:0 0 6px 4px}
input[type=text]{width:100%;border:1.5px solid var(--line);border-radius:15px;background:#fff;padding:13px 15px;font-size:16px;color:var(--ink);outline:0}
input[type=text]:focus{border-color:#c98e94;box-shadow:0 0 0 4px #e7b9bc2e}
.modes{display:flex;gap:8px;margin:14px 0}
.mode{flex:1;border:1.5px solid var(--line);background:#fff;border-radius:13px;padding:10px;font-size:13px;color:var(--muted);text-align:center;cursor:pointer}
.mode.on{border-color:var(--pink);color:var(--pink-deep);font-weight:700;background:#fdf3f2}
#coinsBox{display:none;margin:4px 0 10px}
#coinsBox.on{display:block}
.coin-hint{font-size:12px;color:var(--muted);line-height:1.7;margin:0 0 8px 4px}
.coin-row{display:flex;gap:6px}
.coin-row select{flex:1;border:1.5px solid var(--line);border-radius:11px;background:#fff;padding:9px 4px;font-size:14px;color:var(--ink)}
button.go{width:100%;margin-top:14px;border:0;border-radius:16px;padding:15px;background:linear-gradient(145deg,#dba1a4,#c98188);color:#fff;font-size:16px;font-weight:700;letter-spacing:.2em;cursor:pointer;box-shadow:0 8px 18px #c47d8545}
button.go:active{transform:scale(.98)}
button.go:disabled{opacity:.55;cursor:default}
/* ── 摇卦区 ── */
#shakeBox{display:none}
#shakeBox.on{display:block}
.shake-stage{display:flex;gap:14px;align-items:stretch;margin-top:6px}
.coins-pit{flex:1;display:flex;align-items:center;justify-content:center;gap:12px;background:linear-gradient(160deg,#fbf4e8,#f6ecdc);border:1.5px solid #eaddc6;border-radius:18px;min-height:118px;perspective:600px}
.coin{width:52px;height:52px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#e6cf9e,#c9a86a 68%,#b3924f);box-shadow:inset 0 2px 4px #fff8,inset 0 -3px 5px #8a6f3d55,0 4px 10px #8a6f3d33;display:grid;place-items:center;position:relative;color:var(--gold-deep);font-weight:800;font-size:15px;transform-style:preserve-3d}
.coin:before{content:"";position:absolute;width:15px;height:15px;background:#faf3e6;border:1.5px solid #a8894f;box-shadow:inset 0 1px 2px #8a6f3d44}
.coin span{position:relative;z-index:1;background:transparent;writing-mode:vertical-rl;letter-spacing:2px;font-size:11px;transform:translateY(0)}
.coin.flipping{animation:flip .85s cubic-bezier(.3,.6,.4,1)}
@keyframes flip{0%{transform:rotateX(0) translateY(0)}30%{transform:rotateX(540deg) translateY(-34px)}70%{transform:rotateX(900deg) translateY(-8px)}100%{transform:rotateX(1080deg) translateY(0)}}
.coin.zi{background:radial-gradient(circle at 35% 30%,#e6cf9e,#c9a86a 68%,#b3924f)}
.coin.bei span{visibility:hidden}
.stack{width:118px;display:flex;flex-direction:column-reverse;justify-content:flex-start;gap:5px;padding:8px 6px;background:#fff;border:1.5px solid var(--line);border-radius:16px}
.slot{height:15px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-family:ui-monospace,monospace;font-size:12px;color:#d8cabf;background:#faf5f0}
.slot.filled{color:var(--ink);background:#f6efe8;font-weight:700}
.slot.filled.dong{color:var(--pink-deep);background:#fdf0ef}
.shake-status{text-align:center;font-size:13px;color:var(--muted);margin-top:10px;min-height:20px}
.shake-status b{color:var(--pink-deep)}
.quick{display:block;text-align:center;font-size:12px;color:var(--muted);margin-top:8px;text-decoration:underline dotted;cursor:pointer}
#result{display:none;margin-top:22px}
#result.on{display:block}
.meta{font-size:13px;color:var(--muted);line-height:2;border-bottom:1px dashed var(--line);padding-bottom:12px;margin-bottom:14px}
.meta b{color:var(--ink)}
.gua-name{font-size:19px;font-weight:750;margin:0 0 12px;text-align:center}
.gua-name small{color:var(--muted);font-weight:400;font-size:13px}
table{width:100%;border-collapse:collapse;font-size:13.5px}
td{padding:8px 4px;border-bottom:1px solid #f6ece8;text-align:center;white-space:nowrap}
.yao-mark{font-family:ui-monospace,monospace;font-size:15px}
.dong{color:var(--pink-deep);font-weight:700}
.shi{display:inline-block;background:#fdeeed;color:var(--pink-deep);border-radius:7px;padding:1px 7px;font-size:11px;font-weight:700}
.ying{display:inline-block;background:#eaf3f8;color:#5c88a8;border-radius:7px;padding:1px 7px;font-size:11px;font-weight:700}
.foot{margin-top:26px;text-align:center;font-size:12px;color:var(--muted);line-height:2.2}
.foot a{color:var(--pink-deep)}
.err{color:#b35f69;font-size:13px;margin-top:10px;text-align:center}
</style>
</head>
<body>
<main>
  <h1>六爻占卜</h1>
  <p class="sub">正统六爻纳甲筮法 · 依《增删卜易》《卜筮正宗》逐条实现<br>起卦装卦全程确定性计算，可复核、不掺人为</p>

  <div class="card">
    <label for="q">心中默念所问之事，写下来</label>
    <input type="text" id="q" placeholder="例如：这个月的工作机会如何" maxlength="60">
    <div class="modes">
      <div class="mode on" data-m="shake">在线摇卦</div>
      <div class="mode" data-m="coins">我摇过真铜钱了</div>
    </div>

    <div id="shakeBox" class="on">
      <div class="shake-stage">
        <div class="coins-pit">
          <div class="coin" id="coin0"><span>字</span></div>
          <div class="coin" id="coin1"><span>字</span></div>
          <div class="coin" id="coin2"><span>字</span></div>
        </div>
        <div class="stack" id="stack">
          <div class="slot" data-i="0">初</div><div class="slot" data-i="1">二</div><div class="slot" data-i="2">三</div>
          <div class="slot" data-i="3">四</div><div class="slot" data-i="4">五</div><div class="slot" data-i="5">上</div>
        </div>
      </div>
      <div class="shake-status" id="shakeStatus">默念所问之事，摇第 <b>1</b> 次（初爻）</div>
      <button class="go" id="shakeBtn">摇 铜 钱</button>
      <span class="quick" id="quickAll">来不及仪式感？一键摇完六次</span>
    </div>

    <div id="coinsBox">
      <p class="coin-hint">三枚铜钱摇六次，从第一次（初爻）到第六次（上爻），每次记下几个<b>正面（字面）</b>：</p>
      <div class="coin-row" id="coinSelects"></div>
      <button class="go" id="castBtn">起 卦</button>
    </div>
    <div class="err" id="err"></div>
  </div>

  <div class="card" id="result">
    <div class="meta" id="meta"></div>
    <div class="gua-name" id="guaName"></div>
    <table id="yaoTable"></table>
    <button class="go" id="aiBtn" style="margin-top:18px">请 AI 解 卦</button>
    <div id="aiOut" style="display:none;margin-top:16px;padding-top:14px;border-top:1px dashed var(--line);font-size:14px;line-height:2;white-space:pre-wrap"></div>
    <span class="quick" id="again">再占一卦</span>
  </div>

  <p class="foot">
    引擎开源 · 规则与数据表全部标注典籍出处<br>
    <a href="https://github.com/Ariakitty/liuyao-engine" target="_blank" rel="noopener">GitHub: Ariakitty/liuyao-engine</a>　·　前端一行接入：<br>
    <code>import { cast } from '…/liuyao.browser.mjs'</code><br>
    结果仅供研究与娱乐，不构成现实决策建议
  </p>
</main>
<script type="module">
import { cast } from './liuyao.browser.mjs';

const $ = s => document.querySelector(s);
let method = 'shake';
document.querySelectorAll('.mode').forEach(el => el.onclick = () => {
  document.querySelectorAll('.mode').forEach(x => x.classList.remove('on'));
  el.classList.add('on');
  method = el.dataset.m;
  $('#shakeBox').classList.toggle('on', method === 'shake');
  $('#coinsBox').classList.toggle('on', method === 'coins');
});
$('#coinSelects').innerHTML = Array.from({length:6}, (_,i) =>
  `<select id="c${i}">${[0,1,2,3].map(n=>`<option value="${n}" ${n===1?'selected':''}>${n}正</option>`).join('')}</select>`).join('');

const MARK = {6:'✕',7:'─',8:'╌',9:'◯'};
const NAME = {6:'老阴',7:'少阳',8:'少阴',9:'老阳'};
const POS = ['初爻','二爻','三爻','四爻','五爻','上爻'];

// ── 摇卦过程：三枚铜钱摇六次，爻从初爻往上长 ──
function coinFlip() { // 一枚铜钱：1=字（正面）、0=背
  const b = new Uint8Array(1); crypto.getRandomValues(b); return b[0] & 1;
}
let tosses = [];
let shaking = false;

async function shakeOnce() {
  if (shaking || tosses.length >= 6) return;
  shaking = true;
  $('#shakeBtn').disabled = true;
  const faces = [coinFlip(), coinFlip(), coinFlip()];
  for (let i = 0; i < 3; i++) {
    const c = $('#coin' + i);
    c.classList.remove('flipping','bei','zi'); void c.offsetWidth;
    c.classList.add('flipping');
  }
  await new Promise(ok => setTimeout(ok, 870));
  faces.forEach((f, i) => $('#coin' + i).classList.add(f ? 'zi' : 'bei'));
  const zi = faces.reduce((a,b) => a+b, 0);      // 字面数
  const val = [9,8,7,6][zi];                      // 背为阳：3背=老阳9 … 3字=老阴6
  tosses.push(zi);
  const slot = document.querySelector(`.slot[data-i="${tosses.length-1}"]`);
  slot.textContent = MARK[val] + ' ' + NAME[val];
  slot.classList.add('filled');
  if (val === 6 || val === 9) slot.classList.add('dong');
  if (tosses.length < 6) {
    $('#shakeStatus').innerHTML = `${zi}枚字面 → ${NAME[val]}　·　摇第 <b>${tosses.length+1}</b> 次（${POS[tosses.length]}）`;
    $('#shakeBtn').disabled = false;
  } else {
    $('#shakeStatus').innerHTML = '六爻已成，正在装卦…';
    await new Promise(ok => setTimeout(ok, 600));
    doCast(tosses);
  }
  shaking = false;
}
$('#shakeBtn').onclick = shakeOnce;
$('#quickAll').onclick = async () => { while (tosses.length < 6) { await shakeOnce(); await new Promise(ok => setTimeout(ok, 150)); } };

function resetShake() {
  tosses = [];
  document.querySelectorAll('.slot').forEach((s,i) => { s.textContent = ['初','二','三','四','五','上'][+s.dataset.i]; s.className = 'slot'; });
  document.querySelectorAll('.coin').forEach(c => c.classList.remove('bei','zi','flipping'));
  $('#shakeStatus').innerHTML = '默念所问之事，摇第 <b>1</b> 次（初爻）';
  $('#shakeBtn').disabled = false; $('#shakeBtn').style.display = '';
  $('#result').classList.remove('on');
}
$('#again').onclick = () => { resetShake(); window.scrollTo({top:0,behavior:'smooth'}); };

// ── 装卦与展示 ──
function doCast(tossArr) {
  $('#err').textContent = '';
  try {
    const question = $('#q').value.trim();
    const r = cast({ question, method: 'coins', tosses: tossArr });
    $('#meta').innerHTML = `所问：<b>${r.question.replace(/</g,'&lt;')}</b><br>月建 <b>${r.yueJian}</b> · 日辰 <b>${r.riChen}</b> · 旬空 <b>${r.xunKong.join('、')}</b>`;
    $('#guaName').innerHTML = `${r.benGua.name} <small>（${r.benGua.gong} · ${r.benGua.gongWuXing}）</small>` + (r.bianGua ? `　→　${r.bianGua.name}` : ' <small>无动爻</small>');
    $('#yaoTable').innerHTML = [...r.yao].reverse().map(y => `<tr>
      <td class="yao-mark ${y.dong?'dong':''}">${MARK[y.val]}</td>
      <td>${NAME[y.val]}${y.dong?'·动':''}</td>
      <td>${y.liuShen}</td>
      <td><b>${y.liuQin}</b> ${y.ganZhi}（${y.wuXing}）</td>
      <td>${y.shiYing==='世'?'<span class="shi">世</span>':y.shiYing==='应'?'<span class="ying">应</span>':''}</td>
      <td>${y.bianGanZhi?'→ '+y.bianGanZhi.ganZhi+'·'+y.bianGanZhi.liuQin:''}</td>
    </tr>`).join('');
    $('#result').classList.add('on');
    $('#aiBtn').style.display = '';
    $('#aiBtn').disabled = false; $('#aiBtn').textContent = '请 AI 解 卦';
    $('#aiOut').style.display = 'none'; $('#aiOut').textContent = '';
    window.__lastCast = r;
    $('#result').scrollIntoView({behavior:'smooth'});
  } catch (e) {
    $('#err').textContent = e.message;
    if (method === 'shake') { tosses = []; resetShake(); }
  }
}
$('#castBtn').onclick = () => doCast(Array.from({length:6}, (_,i) => +$('#c'+i).value));

// ── AI 解卦：把摇掷结果原样发给服务端复算同一张盘，流式返回解读 ──
$('#aiBtn').onclick = async () => {
  const r = window.__lastCast;
  if (!r) return;
  const btn = $('#aiBtn'), out = $('#aiOut');
  btn.disabled = true; btn.textContent = '解 卦 中 …';
  out.style.display = 'block'; out.textContent = '';
  try {
    const resp = await fetch('https://gua.ariakitty.com/api/divine', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ question: r.question, method: 'coins', tosses: r.tosses, time: r.time })
    });
    if (resp.status === 429) { out.textContent = (await resp.json()).error; btn.style.display='none'; return; }
    if (!resp.ok) throw new Error('解卦服务开小差了（' + resp.status + '）');
    const reader = resp.body.getReader();
    const dec = new TextDecoder();
    let buf = '', started = false;
    while (true) {
      const {done, value} = await reader.read();
      if (done) break;
      buf += dec.decode(value, {stream:true});
      if (!started) {
        const sep = buf.indexOf('\x1e');
        if (sep < 0) continue;
        buf = buf.slice(sep + 1); started = true;
      }
      out.textContent += buf; buf = '';
    }
    btn.style.display = 'none';
  } catch (e) {
    out.textContent = '解卦没成功：' + e.message;
    btn.disabled = false; btn.textContent = '请 AI 解 卦';
  }
};
</script>
</body>
</html>
